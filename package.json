{
  "name": "scuffle",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/"
  },
  "dependencies": {
    "check-word": "^1.1.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "leo-profanity": "^1.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "socket.io": "^4.8.4",
    "stemmer": "^2.0.1",
    "subtlex-word-frequencies": "^2.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "sass": "^1.108.2",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.8"
  }
}
